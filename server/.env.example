# ── Server ────────────────────────────────────────────────────────────────────
PORT=4010
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# Any managed Postgres works (Supabase, Neon, RDS, docker-compose local).
# Supabase: postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Neon:     postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms
# Set true for managed PG that requires TLS (Supabase/Neon). For self-signed
# certs also set PGSSL_REJECT_UNAUTHORIZED=false (Neon/Supabase need neither).
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
# Access-token lifetime (JWT expiry). Default 12h.
JWT_TTL=12h

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (the Vite app URL).
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Stricter bucket for /auth/login (brute-force protection).
LOGIN_RATE_LIMIT_MAX=10
